    {
      "parameters": {
        "jsCode": "const posts = ['']\n\nfor (const item of $input.first().json.blocks) {\n  const content = item.content\n  if (typeof content !== \"string\") continue\n  if (Number.isInteger(+content[0]) || content.startsWith(\"TD;LR\")) {\n    posts.push(content)\n    continue\n  }\n\n  if (content.startsWith('CTA')) {\n    posts.push(\"\")\n    continue\n  }\n  \n  const lastIdx = posts.length - 1\n  posts[lastIdx] = posts[lastIdx] + `\\n${content}`\n}\n\nreturn { posts: posts.filter(Boolean) };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2980,
        1320
      ],
      "id": "2bdcc6c8-ad92-455d-a3b8-6908c41628b3",
      "name": "Create Replies List"
    },
