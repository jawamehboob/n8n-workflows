    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const websiteRaw = item.json.property_website_url || item.json.Website_URL || '';\n  let clean_website_url = '';\n  let domain_name = '';\n  let has_website = false;\n\n  // Proceed only if there is a non-empty, non-\"n/a\" value\n  if (websiteRaw && websiteRaw.trim() !== '' && websiteRaw.toLowerCase() !== 'n/a') {\n    // Ensure absolute URL with protocol\n    clean_website_url = (websiteRaw.startsWith('http://') || websiteRaw.startsWith('https://'))\n      ? websiteRaw\n      : `https://${websiteRaw}`;\n\n    // Extract bare domain (remove protocol and optional www), drop any path/query/fragment\n    domain_name = clean_website_url\n      .replace(/^https?:\\/\\/(www\\.)?/, '')\n      .split('/')[0]\n      .trim();\n\n    has_website = domain_name !== '';\n  }\n\n  return {\n    json: {\n      ...item.json,\n      clean_website_url,\n      domain_name,\n      has_website\n    }\n  };\n});\n"
      },
